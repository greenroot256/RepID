root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown; do not strip them.
trim_trailing_whitespace = false

[*.cash]
# CashScript indentation is 4 spaces, matching the covenant sources.
indent_size = 4
