# npm's own peer-dependency resolution crashes on this dependency set.
#
# Reproduced on npm 10.9.2: with no lockfile present, `npm install` aborts with
#     Cannot read properties of null (reading 'edgesOut')
# while the same install succeeds with the legacy algorithm. The failure is in
# npm's tree building, not in this package.
#
# legacy-peer-deps=true selects that algorithm.
#
# This only matters when npm has to resolve the tree from scratch: a fresh
# checkout with the committed lockfile installs fine either way, via `npm ci`.
# It is set in a file rather than passed on the command line so that `npm
# install`, `npm ci` and `npm update` agree, and so a lockfile written by one
# command is not rejected by the next. Contributors hit the crash after editing
# package.json, when the lockfile no longer covers the new tree.
#
# Re-test before assuming it is still needed: if a later npm release fixes the
# resolution, delete this file and this comment rather than leaving it behind as
# folklore.
legacy-peer-deps=true
