        "@repid/sdk": "file:..\\..\\..\\..\\repid-sdk",
        "argon2": "^0.45.1",
        "cashscript": "^0.13.3",
        "fastify": "^5.1.0",
        "pg": "^8.13.0"
    },
    "devDependencies": {
        "@types/node": "^22.7.0",
        "@types/pg": "^8.11.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0"
    }
