{
    "name":  "@cash-freelancers/contracts",
    "private":  true,
    "version":  "0.0.1",
    "type":  "module",
    "main":  "src/index.ts",
    "types":  "src/index.ts",
    "dependencies":  {
                         "cashscript":  "^0.13.3",
                         "mainnet-js":  "^2.5.4",
                         "@cash-freelancers/shared":  "workspace:*"
                     },
    "devDependencies":  {
                            "cashc":  "^0.13.3",
                            "typescript":  "^5.6.0",
                            "@types/node":  "^22.7.0",
                            "@bitauth/libauth":  "^3.1.0-next.8",
                            "tsx":  "^4.19.0"
                        },
    "scripts":  {
                    "typecheck":  "tsc --noEmit",
                    "build":  "tsc -p tsconfig.json",
                    "simulate:two-party":  "tsx --env-file-if-exists=../../.env scripts/simulate-arbitrated-signing.ts",
                    "generate:wallets":  "tsx --env-file-if-exists=../../.env scripts/generate-test-wallets.ts",
                    "compile:repid":  "node scripts/compile-repid-contracts.mjs",
                    "verify:wallets":  "tsx --env-file-if-exists=../../.env scripts/verify-test-wallets.ts",
                    "wallets:balances":  "tsx --env-file-if-exists=../../.env scripts/test-wallet-balances.ts",
                    "simulate:reclaim":  "tsx --env-file-if-exists=../../.env scripts/simulate-reclaim-timeout.ts",
    "test:chain": "tsx scripts/test-escrow-chain.ts",
    "test:onchain": "tsx --env-file-if-exists=../../.env scripts/test-escrow-onchain.ts",
                    "test:repid":  "tsx scripts/test-repid-wrappers.ts"
                }
}