{
  "name": "cash-freelancers",
  "private": true,
  "version": "0.0.1",
  "description": "Freelance marketplace with Bitcoin Cash payments and escrow",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter api migrate"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
